{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucketP5",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::taller-eve-p5-ACCOUNT_ID"
    },
    {
      "Sid": "LeerObjetosP5",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::taller-eve-p5-ACCOUNT_ID/*"
    }
  ]
}
